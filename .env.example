# Vonage credentials
VONAGE_APPLICATION_ID=<application-uuid>
VONAGE_PRIVATE_KEY64=<base64-encoded-private-key>
VONAGE_API_KEY=<api-key>
VONAGE_API_SECRET=<api-secret>

# Virtual numbers
LVN_A=<number-presented-to-hcp>
LVN_B=<number-presented-to-patient>

# Server
PORT=3000
BASE_URL=<ngrok-https-url>

# Default phone numbers for CLI prompt (optional)
DEFAULT_HCP_NUMBER=<hcp-phone-e164>
DEFAULT_PATIENT_NUMBER=<patient-phone-e164>
